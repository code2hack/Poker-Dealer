        "turn/interrupt"
      ]
    },
    "outboundOperation": {
      "states": [
        "none",
        "startingTurn",
        "steeringTurn",
        "interrupting",
        "unknownAcceptance"
      ],
      "rules": {
        "send": "turn/start",
        "steer": "turn/steer with exact expectedTurnId",
        "stop": "turn/interrupt with exact turnId; remain interrupting until authoritative turn/completed",
        "unknown": "preserve exact draft/action and reconcile; never blindly replay"
      }
    },
    "blockingRequests": {
      "categories": [
        "commandApproval",
        "fileChangeApproval",
        "permissionEscalation",
        "mcpElicitation",
        "toolUserInput"
