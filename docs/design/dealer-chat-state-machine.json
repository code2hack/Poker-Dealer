        "idle": {
          "icon": null
        },
        "active": {
          "noFlagsIcon": {
            "symbol": "⏳",
            "color": "blue"
          },
          "flags": {
            "waitingOnApproval": {
              "symbol": "?",
              "color": "yellow"
            },
            "waitingOnUserInput": {
              "symbol": "●",
              "color": "green"
            }
          },
          "bothFlagsOrder": [
            "waitingOnApproval",
            "waitingOnUserInput"
          ]
        },
        "systemError": {
          "icon": {
            "symbol": "!",
            "color": "red"
          }
        }
      },
      "prohibitedDerivedStates": [
        "READY",
        "WORKING",
        "BUSY",
        "RUNNING",
        "ATTENTION_REQUIRED",
        "UNKNOWN"
      ],
      "staleRule": "Hide the runtime icon while Dealer lacks fresh authority; connection state is rendered separately."
    },
    "connectionAuthority": {
      "states": [
        "fresh",
        "reconnecting",
        "reconciling",
        "hostUnavailable"
      ],
      "notThreadStatus": true,
      "unsafeMutationsEnabledOnlyIn": [
        "fresh"
      ]
    },
    "activeTurn": {
      "fields": [
        "threadId",
        "turnId",
        "turnStatus",
        "turnKind",
        "canSteer"
      ],
